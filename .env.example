FRELY_NETWORK_BIND_ADDRESS=127.0.0.1
FRELY_NETWORK_PUBLISHED_PORT=13600
FRELY_NETWORK_IMAGE=frely-network-broker-mcp:local

# Broker discovery and identity.
GRAPH_ENDPOINT=
GRAPH_METADATA_GATEWAY=
ENS_RPC_URL=
ERC8004_REGISTRY_ADDRESS=

# Consumer wallet for paid external capability calls.
X402_ACCOUNT_ID=
X402_PRIVATE_KEY=
X402_MAX_AMOUNT=

# Network acts as a normal Frely API client at this boundary.
FRELY_API_KEY=
FRELY_RESPONSES_URL=https://api.frely.cloud/v1/responses
FRELY_A2A_DEFAULT_MODEL=vision-basic
FRELY_NETWORK_A2A_AGENT_ID=frely-network

# Network-owned public x402 resource.
X402_FACILITATOR_ACCOUNT_ID=
X402_FACILITATOR_PRIVATE_KEY=
FRELY_NETWORK_X402_AMOUNT=
FRELY_NETWORK_X402_ASSET=
FRELY_NETWORK_X402_PAY_TO=
FRELY_NETWORK_X402_TIMEOUT_SECONDS=60
FRELY_NETWORK_X402_RESOURCE_URL=https://network.frely.cloud/x402/frely/responses
FRELY_NETWORK_X402_REPLAY_DIR=/var/lib/frely-network/x402-replay
