---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import CapabilityFlow from "../components/CapabilityFlow.astro";
import NetworkArchitecture from "../components/NetworkArchitecture.astro";
import ProviderIdentity from "../components/ProviderIdentity.astro";
import CreatorSection from "../components/CreatorSection.astro";
import "../styles/network-story.css";

const year = new Date().getFullYear();
---

<BaseLayout>
  <main>
    <Header />
    <Hero />
    <div class="after-reveal" data-testid="after-reveal">
      <NetworkArchitecture />
      <ProviderIdentity />
      <CapabilityFlow />
      <CreatorSection />
      <footer class="story-footer">
        <div><a href="#top" aria-label="Back to Frely Network"><img src="/logo.png?v=blue-1133" alt="Frely Network" width="168" height="70" /></a><p>Open identity. Private execution.</p></div>
        <div><p data-testid="site-footer">© {year} Frely Network</p><a href="https://github.com/FrelyHQ/frely-network" target="_blank" rel="noreferrer">GitHub</a></div>
      </footer>
    </div>
  </main>
</BaseLayout>

<script>
  import "../scripts/network-story";
</script>

<style>
  .after-reveal {
    position: relative;
    z-index: 5;
    background: #000;
  }
</style>
