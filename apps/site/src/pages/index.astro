---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import CapabilityFlow from "../components/CapabilityFlow.astro";

const year = new Date().getFullYear();
---

<BaseLayout>
  <main>
    <Header />
    <Hero />
    <div class="after-reveal" data-testid="after-reveal" hidden aria-hidden="true">
      <CapabilityFlow />
      <footer class="border-t border-[var(--border)] py-8 text-center text-sm text-[var(--muted-foreground)]">
        <p data-testid="site-footer">© {year} Frely Network</p>
      </footer>
    </div>
  </main>
</BaseLayout>

<style>
  .after-reveal {
    position: relative;
    z-index: 5;
    background: var(--background);
  }
</style>
