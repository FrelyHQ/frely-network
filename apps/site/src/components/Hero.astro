---
/**
 * Full-viewport Spline stage.
 * Splash → Engaged (keep Spline post-click scene + brand overlays) → Details (wheel to #flow).
 */
const GITHUB = "https://github.com/FrelyHQ/frely-network";
/** Replace when a real supported-agent count is available. */
const AGENT_COUNT_PLACEHOLDER = "—";
const DEFAULT_SPLINE_PUBLIC =
  "https://my.spline.design/aidatamodelinteraction-yXFK4f6oAzDsrDztvyJ1dXk4/";
const splineScene = import.meta.env.PUBLIC_SPLINE_SCENE as string | undefined;
const splinePublic =
  (import.meta.env.PUBLIC_SPLINE_PUBLIC as string | undefined) || DEFAULT_SPLINE_PUBLIC;
const useViewer = Boolean(splineScene);
---

<section id="top" class="stage" data-testid="stage" data-state="splash">
  <div class="stage-spline" data-testid="spline-layer" aria-hidden="true">
    <div class="stage-ambient" data-testid="spline-ambient">
      <div class="ambient-glow"></div>
      <div class="ambient-ring ambient-ring--a"></div>
      <div class="ambient-ring ambient-ring--b"></div>
      <div class="ambient-core"></div>
    </div>
    {
      useViewer ? (
        <div class="stage-spline-frame" data-testid="spline-viewer-host">
          <script
            is:inline
            type="module"
            src="https://unpkg.com/@splinetool/viewer@1.9.82/build/spline-viewer.js"
          ></script>
          <spline-viewer
            url={splineScene}
            style="width:100%;height:100%;background:transparent;"
          ></spline-viewer>
        </div>
      ) : (
        <iframe
          title="Frely Network scene"
          src={splinePublic}
          class="stage-spline-frame"
          loading="eager"
          allow="autoplay; fullscreen"
          data-testid="spline-iframe"
        ></iframe>
      )
    }
  </div>

  <div class="stage-viewport" data-testid="stage-viewport">
    <div class="stage-chrome" data-testid="splash">
      <a class="stage-logo" href="/" aria-label="Frely Network" data-testid="splash-logo">
        <img src="/logo.png" alt="" width="168" height="44" class="stage-logo-img" />
      </a>

      <button
        type="button"
        class="click-me"
        data-testid="click-me"
        aria-label="Enter Frely Network scene"
      >
        <span class="click-me-label">
          <span>Click Me</span>
          <span class="click-me-arrow" aria-hidden="true">↓</span>
        </span>
      </button>

      <div class="scene-brand" data-testid="scene-brand" hidden>
        <p class="scene-brand-title" data-testid="scene-title">Frely Network</p>
        <p class="scene-brand-count" data-testid="agent-count">{AGENT_COUNT_PLACEHOLDER}</p>
        <p class="scene-brand-caption" data-testid="agent-count-label">Supported agents</p>
        <p class="scene-brand-hint" data-testid="scroll-hint">Scroll for project details</p>
      </div>
    </div>
  </div>

  <div id="details" class="stage-details-lead" data-testid="details-lead" hidden>
    <div class="details-lead-panel animate-rise">
      <p class="details-eyebrow" data-testid="hero-brand">Frely Network</p>
      <h1 class="details-title" data-testid="reveal-title">Open agent capability network</h1>
      <p class="details-body" data-testid="reveal-body">
        Let an agent discover, verify, pay for, and use capabilities it does not have — Graph
        discovery, ENS / ERC-8004 identity, Hedera x402 settlement.
      </p>
      <div class="details-actions">
        <a
          href={GITHUB}
          target="_blank"
          rel="noreferrer"
          class="btn btn-primary btn-lg"
          data-testid="cta-github"
        >
          View on GitHub
        </a>
        <a href="#flow" class="btn btn-ghost btn-lg" data-testid="cta-flow">See the path</a>
      </div>
    </div>
  </div>
</section>

<script>
  const AGENT_PLACEHOLDER = "—";
  const stage = document.getElementById("top");
  const clickMe = document.querySelector("[data-testid='click-me']");
  const sceneBrand = document.querySelector("[data-testid='scene-brand']");
  const detailsLead = document.querySelector("[data-testid='details-lead']");
  const after = document.querySelector("[data-testid='after-reveal']");
  const agentCount = document.querySelector("[data-testid='agent-count']");
  const iframe = document.querySelector("[data-testid='spline-iframe']");

  if (agentCount instanceof HTMLElement && !agentCount.textContent?.trim()) {
    agentCount.textContent = AGENT_PLACEHOLDER;
  }

  const goEngaged = () => {
    if (!stage || stage.dataset.state === "engaged" || stage.dataset.state === "details") return;
    stage.dataset.state = "engaged";
    document.documentElement.dataset.landing = "engaged";
    if (sceneBrand instanceof HTMLElement) sceneBrand.hidden = false;
    if (clickMe instanceof HTMLElement) clickMe.setAttribute("aria-hidden", "true");
  };

  const goDetails = () => {
    if (!stage || stage.dataset.state === "details") return;
    if (stage.dataset.state === "splash") goEngaged();
    stage.dataset.state = "details";
    document.documentElement.dataset.landing = "revealed";
    document.body.classList.add("is-revealed");
    if (detailsLead instanceof HTMLElement) detailsLead.hidden = false;
    if (after instanceof HTMLElement) {
      after.hidden = false;
      after.setAttribute("aria-hidden", "false");
    }
    window.requestAnimationFrame(() => {
      const details = document.getElementById("details");
      if (details) {
        details.scrollIntoView({ behavior: "smooth", block: "start" });
      } else {
        window.scrollTo({ top: Math.max(window.innerHeight * 0.85, 1), behavior: "smooth" });
      }
    });
  };

  clickMe?.addEventListener("click", (e) => {
    e.preventDefault();
    goEngaged();
  });
  clickMe?.addEventListener("keydown", (e) => {
    if (e instanceof KeyboardEvent && (e.key === "Enter" || e.key === " ")) {
      e.preventDefault();
      goEngaged();
    }
  });

  // Cross-origin iframe clicks do not bubble; blur ≈ user interacted with the scene.
  window.addEventListener("blur", () => {
    window.requestAnimationFrame(() => {
      if (iframe instanceof HTMLIFrameElement && document.activeElement === iframe) {
        goEngaged();
      }
    });
  });

  let wheelLocked = false;
  window.addEventListener(
    "wheel",
    (e) => {
      if (document.body.classList.contains("is-revealed")) return;
      if (e.deltaY <= 0) return;
      e.preventDefault();
      if (wheelLocked) return;
      wheelLocked = true;
      goDetails();
    },
    { passive: false },
  );

  if (iframe instanceof HTMLIFrameElement) {
    const markReady = () => stage?.classList.add("is-spline-ready");
    iframe.addEventListener("load", markReady);
    try {
      if (iframe.contentDocument?.readyState === "complete") markReady();
    } catch {
      // cross-origin
    }
  } else {
    // Viewer / mobile ambient path
    window.setTimeout(() => stage?.classList.add("is-spline-ready"), 400);
  }
</script>

<style>
  .stage {
    position: relative;
    isolation: isolate;
  }

  .stage-viewport {
    position: relative;
    z-index: 1;
    min-height: 100svh;
  }

  .stage-spline {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: #05070d;
    transition:
      opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0.75s;
  }

  .stage-ambient {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition: opacity 0.7s ease;
  }

  .ambient-glow {
    position: absolute;
    width: min(52vw, 420px);
    height: min(52vw, 420px);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.28), transparent 68%);
    filter: blur(8px);
    animation: ambient-breathe 3.6s ease-in-out infinite;
  }

  .ambient-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(147, 197, 253, 0.18);
  }

  .ambient-ring--a {
    width: min(38vw, 280px);
    height: min(22vw, 150px);
    transform: rotateX(66deg) rotateZ(-8deg);
    animation: ambient-spin 18s linear infinite;
  }

  .ambient-ring--b {
    width: min(48vw, 360px);
    height: min(28vw, 190px);
    border-color: rgba(96, 165, 250, 0.12);
    transform: rotateX(66deg) rotateZ(12deg);
    animation: ambient-spin 26s linear infinite reverse;
  }

  .ambient-core {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff, #93c5fd 45%, #2563eb 100%);
    box-shadow: 0 0 24px rgba(96, 165, 250, 0.55);
  }

  @keyframes ambient-breathe {
    0%,
    100% {
      transform: scale(0.92);
      opacity: 0.7;
    }
    50% {
      transform: scale(1.05);
      opacity: 1;
    }
  }

  @keyframes ambient-spin {
    to {
      transform: rotateX(66deg) rotateZ(352deg);
    }
  }

  .stage-spline-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: transparent;
    opacity: 0;
    transition: opacity 0.9s ease;
    pointer-events: none;
  }

  .stage.is-spline-ready .stage-spline-frame {
    opacity: 1;
    pointer-events: auto;
  }

  .stage.is-spline-ready .stage-ambient {
    opacity: 0;
  }

  /* Keep Spline through engaged; only ease back on details */
  .stage[data-state="details"] .stage-spline {
    opacity: 0.22;
    pointer-events: none;
  }

  .stage-chrome {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .stage-logo {
    pointer-events: auto;
    position: absolute;
    top: 1.15rem;
    left: 1.25rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .stage-logo-img {
    height: 2.25rem;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 12px rgba(0, 0, 0, 0.45));
  }

  .click-me {
    pointer-events: auto;
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #f4f7fb;
    cursor: pointer;
    appearance: none;
    font: inherit;
  }

  /* Once Spline is ready, let the scene receive the click so its post-click UI plays */
  .stage.is-spline-ready .click-me {
    pointer-events: none;
  }

  .click-me-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: min(8vh, 72px);
    padding: 0.7rem 1.15rem;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.28);
    background: rgba(12, 16, 24, 0.72);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    backdrop-filter: blur(12px);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
    color: #f4f7fb;
  }

  .click-me-arrow {
    opacity: 0.8;
    animation: pulse-glow 1.8s ease-in-out infinite;
  }

  .stage.is-spline-ready .click-me-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    box-shadow: none;
    background: transparent;
  }

  .stage[data-state="engaged"] .click-me,
  .stage[data-state="details"] .click-me {
    display: none;
  }

  .click-me:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: -6px;
  }

  .scene-brand {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.35rem;
    padding: 1.5rem;
    text-align: center;
    pointer-events: none;
    animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .scene-brand-title {
    margin: 0;
    font-size: clamp(1.65rem, 3.6vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #f4f7fb;
    text-shadow: 0 8px 40px rgba(0, 0, 0, 0.65);
  }

  .scene-brand-count {
    margin: 0.35rem 0 0;
    font-size: clamp(2.8rem, 8vw, 5.2rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #fff;
    text-shadow: 0 10px 48px rgba(0, 0, 0, 0.7);
  }

  .scene-brand-caption {
    margin: 0.15rem 0 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(226, 232, 240, 0.78);
  }

  .scene-brand-hint {
    margin: 1.4rem 0 0;
    font-size: 0.8rem;
    color: rgba(148, 163, 184, 0.9);
  }

  .stage[data-state="details"] .stage-chrome {
    opacity: 0;
    visibility: hidden;
  }

  .stage-details-lead {
    position: relative;
    z-index: 3;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 5.5rem 1.5rem 3rem;
    background: var(--background);
  }

  .stage[data-state="splash"] .stage-details-lead,
  .stage[data-state="engaged"] .stage-details-lead {
    display: none;
  }

  .details-lead-panel {
    width: min(42rem, 100%);
    margin-inline: auto;
    text-align: center;
  }

  .details-eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--primary);
  }

  .details-title {
    margin: 1rem 0 0;
    font-size: clamp(2.1rem, 4.5vw, 3.35rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .details-body {
    margin: 1.15rem auto 0;
    max-width: 34rem;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--muted-foreground);
  }

  .details-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .stage-spline-frame {
      display: none;
      pointer-events: none !important;
    }

    .stage-ambient {
      opacity: 1;
    }

    .stage.is-spline-ready .click-me {
      pointer-events: auto;
    }

    .stage.is-spline-ready .click-me-label {
      position: static;
      width: auto;
      height: auto;
      margin-top: min(10vh, 88px);
      padding: 0.7rem 1.15rem;
      overflow: visible;
      clip: auto;
      white-space: normal;
      border: 1px solid rgba(148, 163, 184, 0.28);
      background: rgba(12, 16, 24, 0.72);
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
    }

    .click-me:focus-visible {
      outline-offset: 3px;
    }
  }
</style>
