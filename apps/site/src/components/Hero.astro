---
/**
 * Full-viewport Spline stage.
 * Splash: brand corner + page-owned Click Me.
 * Reveal: product copy focus; Spline fades out (no return to splash).
 */
const GITHUB = "https://github.com/FrelyHQ/frely-network";
const tags = ["ENS", "ERC-8004", "The Graph", "Hedera", "x402"];
const DEFAULT_SPLINE_PUBLIC =
  "https://my.spline.design/aidatamodelinteraction-yXFK4f6oAzDsrDztvyJ1dXk4/";
const splineScene = import.meta.env.PUBLIC_SPLINE_SCENE as string | undefined;
const splinePublic =
  (import.meta.env.PUBLIC_SPLINE_PUBLIC as string | undefined) || DEFAULT_SPLINE_PUBLIC;
const useViewer = Boolean(splineScene);
const FALLBACK_POSTER =
  "https://community-filepreview.spline.design/e41b79f5-7a6d-4123-814b-7d2e60ce7c44.jpg";
---

<section id="top" class="stage" data-testid="stage" data-state="splash">
  <!-- Full-bleed Spline (splash hero; fades on reveal). Poster stays until iframe paints. -->
  <div class="stage-spline" data-testid="spline-layer" aria-hidden="true">
    <img
      class="stage-spline-fallback"
      src={FALLBACK_POSTER}
      alt=""
      width="1600"
      height="900"
      decoding="async"
      data-testid="spline-fallback"
    />
    {
      useViewer ? (
        <div class="stage-spline-frame" data-testid="spline-viewer-host">
          <script
            is:inline
            type="module"
            src="https://unpkg.com/@splinetool/viewer@1.9.82/build/spline-viewer.js"
          ></script>
          <spline-viewer
            url={splineScene}
            style="width:100%;height:100%;background:transparent;"
          ></spline-viewer>
        </div>
      ) : (
        <iframe
          title="Frely Network scene"
          src={splinePublic}
          class="stage-spline-frame"
          loading="eager"
          allow="autoplay; fullscreen"
          data-testid="spline-iframe"
        ></iframe>
      )
    }
    <div class="stage-spline-veil"></div>
  </div>

  <!-- Splash chrome -->
  <div class="stage-splash" data-testid="splash">
    <p class="stage-brand" data-testid="splash-brand">Frely Network</p>
    <button type="button" class="click-me" data-testid="click-me" aria-label="Enter Frely Network">
      <span>Click Me</span>
      <span class="click-me-arrow" aria-hidden="true">↓</span>
    </button>
  </div>

  <!-- Reveal: product focus -->
  <div class="stage-reveal" data-testid="reveal" hidden>
    <div class="reveal-panel animate-rise">
      <p class="reveal-eyebrow" data-testid="hero-brand">Frely Network</p>
      <h1 class="reveal-title" data-testid="reveal-title">Open agent capability network</h1>
      <p class="reveal-body" data-testid="reveal-body">
        Let an agent discover, verify, pay for, and use capabilities it does not have — Graph
        discovery, ENS / ERC-8004 identity, Hedera x402 settlement.
      </p>
      <div class="reveal-actions">
        <a
          href={GITHUB}
          target="_blank"
          rel="noreferrer"
          class="btn btn-primary btn-lg"
          data-testid="cta-github"
        >
          View on GitHub
        </a>
        <a href="#flow" class="btn btn-ghost btn-lg" data-testid="cta-flow">See the path</a>
      </div>
      <ul class="reveal-tags" data-testid="hero-tags">
        {
          tags.map((tag) => (
            <li>{tag}</li>
          ))
        }
      </ul>
      <p class="reveal-note">Dual plane · EVM identity & discovery · Hedera payment</p>
    </div>
  </div>
</section>

<script>
  const stage = document.getElementById("top");
  const clickMe = document.querySelector("[data-testid='click-me']");
  const reveal = document.querySelector("[data-testid='reveal']");
  const after = document.querySelector("[data-testid='after-reveal']");

  const goReveal = () => {
    if (!stage || stage.dataset.state === "revealed") return;
    stage.dataset.state = "revealed";
    document.documentElement.dataset.landing = "revealed";
    if (reveal instanceof HTMLElement) reveal.hidden = false;
    if (after instanceof HTMLElement) {
      after.hidden = false;
      after.setAttribute("aria-hidden", "false");
    }
    // Soft scroll lock release — page can grow past splash
    document.body.classList.add("is-revealed");
    window.setTimeout(() => {
      reveal?.querySelector("h1")?.scrollIntoView({ behavior: "smooth", block: "center" });
    }, 320);
  };

  clickMe?.addEventListener("click", goReveal);
  clickMe?.addEventListener("keydown", (e) => {
    if (e instanceof KeyboardEvent && (e.key === "Enter" || e.key === " ")) {
      e.preventDefault();
      goReveal();
    }
  });

  const iframe = document.querySelector("[data-testid='spline-iframe']");
  if (iframe instanceof HTMLIFrameElement) {
    const markReady = () => stage?.classList.add("is-spline-ready");
    iframe.addEventListener("load", markReady);
    // If already complete (bfcache / fast cache)
    try {
      if (iframe.contentDocument?.readyState === "complete") markReady();
    } catch {
      // cross-origin — wait for load only
    }
  }
</script>

<style>
  .stage {
    position: relative;
    min-height: 100svh;
    isolation: isolate;
  }

  .stage-spline {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: #000;
    transition:
      opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0.85s;
  }

  .stage-spline-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 1;
  }

  .stage-spline-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: transparent;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .stage.is-spline-ready .stage-spline-frame {
    opacity: 1;
  }

  .stage-spline-veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 60% 50% at 50% 48%, transparent 20%, rgba(0, 0, 0, 0.35) 100%);
    opacity: 0;
    transition: opacity 0.7s ease;
  }

  .stage[data-state="revealed"] .stage-spline {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .stage-splash {
    position: relative;
    z-index: 2;
    min-height: 100svh;
    display: grid;
    place-items: center;
    pointer-events: none;
    transition:
      opacity 0.45s ease,
      visibility 0.45s;
  }

  .stage-brand {
    position: absolute;
    top: 1.35rem;
    left: 1.5rem;
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--primary);
    pointer-events: none;
  }

  .click-me {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    /* Sit near the floating subject / scene CTA */
    margin-top: min(8vh, 72px);
    padding: 0.7rem 1.15rem;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.28);
    background: rgba(12, 16, 24, 0.72);
    color: #f4f7fb;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    backdrop-filter: blur(12px);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .click-me:hover {
    transform: translateY(-2px);
    border-color: rgba(96, 165, 250, 0.55);
    background: rgba(20, 28, 44, 0.85);
  }

  .click-me:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .click-me-arrow {
    opacity: 0.8;
    animation: pulse-glow 1.8s ease-in-out infinite;
  }

  .stage[data-state="revealed"] .stage-splash {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .stage-reveal {
    position: relative;
    z-index: 3;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 5.5rem 1.5rem 3rem;
  }

  .stage[data-state="splash"] .stage-reveal {
    display: none;
  }

  .reveal-panel {
    width: min(42rem, 100%);
    margin-inline: auto;
    text-align: center;
  }

  .reveal-eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--primary);
  }

  .reveal-title {
    margin: 1rem 0 0;
    font-size: clamp(2.1rem, 4.5vw, 3.35rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .reveal-body {
    margin: 1.15rem auto 0;
    max-width: 34rem;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--muted-foreground);
  }

  .reveal-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
    justify-content: center;
  }

  .reveal-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    justify-content: center;
  }

  .reveal-tags li {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted-foreground);
    background: rgba(255, 255, 255, 0.03);
  }

  .reveal-note {
    margin: 1.1rem 0 0;
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  /* Mobile: prefer poster — Spline iframe is heavy */
  @media (max-width: 640px) {
    .stage-spline-frame {
      display: none;
    }

    .stage-spline-fallback {
      opacity: 1;
      filter: saturate(1.05) brightness(0.92);
    }

    .click-me {
      margin-top: min(22vh, 160px);
    }
  }
</style>
