---
/**
 * Full-viewport Spline stage.
 * Splash: brand + scene Click Me (page owns hit layer).
 * Reveal: product copy; Spline fades; splash is removed from layout (no ghost black scroll).
 */
const GITHUB = "https://github.com/FrelyHQ/frely-network";
const tags = ["ENS", "ERC-8004", "The Graph", "Hedera", "x402"];
const DEFAULT_SPLINE_PUBLIC =
  "https://my.spline.design/aidatamodelinteraction-yXFK4f6oAzDsrDztvyJ1dXk4/";
const splineScene = import.meta.env.PUBLIC_SPLINE_SCENE as string | undefined;
const splinePublic =
  (import.meta.env.PUBLIC_SPLINE_PUBLIC as string | undefined) || DEFAULT_SPLINE_PUBLIC;
const useViewer = Boolean(splineScene);
---

<section id="top" class="stage" data-testid="stage" data-state="splash">
  <!-- Ambient stage + Spline. No full-bleed poster — that read as a giant photo flash. -->
  <div class="stage-spline" data-testid="spline-layer" aria-hidden="true">
    <div class="stage-ambient" data-testid="spline-ambient">
      <div class="ambient-glow"></div>
      <div class="ambient-ring ambient-ring--a"></div>
      <div class="ambient-ring ambient-ring--b"></div>
      <div class="ambient-core"></div>
    </div>
    {
      useViewer ? (
        <div class="stage-spline-frame" data-testid="spline-viewer-host">
          <script
            is:inline
            type="module"
            src="https://unpkg.com/@splinetool/viewer@1.9.82/build/spline-viewer.js"
          ></script>
          <spline-viewer
            url={splineScene}
            style="width:100%;height:100%;background:transparent;"
          ></spline-viewer>
        </div>
      ) : (
        <iframe
          title="Frely Network scene"
          src={splinePublic}
          class="stage-spline-frame"
          loading="eager"
          allow="autoplay; fullscreen"
          data-testid="spline-iframe"
        ></iframe>
      )
    }
  </div>

  <!-- Absolute overlay — must NOT consume document height after reveal -->
  <div class="stage-splash" data-testid="splash">
    <p class="stage-brand" data-testid="splash-brand">Frely Network</p>
    <button
      type="button"
      class="click-me"
      data-testid="click-me"
      aria-label="Enter Frely Network"
    >
      <span class="click-me-label">
        <span>Click Me</span>
        <span class="click-me-arrow" aria-hidden="true">↓</span>
      </span>
    </button>
  </div>

  <div class="stage-reveal" data-testid="reveal" hidden>
    <div class="reveal-panel animate-rise">
      <p class="reveal-eyebrow" data-testid="hero-brand">Frely Network</p>
      <h1 class="reveal-title" data-testid="reveal-title">Open agent capability network</h1>
      <p class="reveal-body" data-testid="reveal-body">
        Let an agent discover, verify, pay for, and use capabilities it does not have — Graph
        discovery, ENS / ERC-8004 identity, Hedera x402 settlement.
      </p>
      <div class="reveal-actions">
        <a
          href={GITHUB}
          target="_blank"
          rel="noreferrer"
          class="btn btn-primary btn-lg"
          data-testid="cta-github"
        >
          View on GitHub
        </a>
        <a href="#flow" class="btn btn-ghost btn-lg" data-testid="cta-flow">See the path</a>
      </div>
      <ul class="reveal-tags" data-testid="hero-tags">
        {
          tags.map((tag) => (
            <li>{tag}</li>
          ))
        }
      </ul>
      <p class="reveal-note">Dual plane · EVM identity & discovery · Hedera payment</p>
    </div>
  </div>
</section>

<script>
  const stage = document.getElementById("top");
  const clickMe = document.querySelector("[data-testid='click-me']");
  const reveal = document.querySelector("[data-testid='reveal']");
  const after = document.querySelector("[data-testid='after-reveal']");

  const goReveal = () => {
    if (!stage || stage.dataset.state === "revealed") return;
    stage.dataset.state = "revealed";
    document.documentElement.dataset.landing = "revealed";
    if (reveal instanceof HTMLElement) reveal.hidden = false;
    if (after instanceof HTMLElement) {
      after.hidden = false;
      after.setAttribute("aria-hidden", "false");
    }
    document.body.classList.add("is-revealed");
    // Stay at top of reveal — do not leave a ghost splash region above the copy
    window.requestAnimationFrame(() => {
      window.scrollTo({ top: 0, behavior: "auto" });
    });
  };

  clickMe?.addEventListener("click", goReveal);
  clickMe?.addEventListener("keydown", (e) => {
    if (e instanceof KeyboardEvent && (e.key === "Enter" || e.key === " ")) {
      e.preventDefault();
      goReveal();
    }
  });

  const iframe = document.querySelector("[data-testid='spline-iframe']");
  if (iframe instanceof HTMLIFrameElement) {
    const markReady = () => stage?.classList.add("is-spline-ready");
    iframe.addEventListener("load", markReady);
    try {
      if (iframe.contentDocument?.readyState === "complete") markReady();
    } catch {
      // cross-origin
    }
  }
</script>

<style>
  .stage {
    position: relative;
    isolation: isolate;
  }

  .stage[data-state="splash"] {
    min-height: 100svh;
  }

  .stage-spline {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: #05070d;
    transition:
      opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0.75s;
  }

  .stage-ambient {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition: opacity 0.7s ease;
  }

  .ambient-glow {
    position: absolute;
    width: min(52vw, 420px);
    height: min(52vw, 420px);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.28), transparent 68%);
    filter: blur(8px);
    animation: ambient-breathe 3.6s ease-in-out infinite;
  }

  .ambient-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(147, 197, 253, 0.18);
  }

  .ambient-ring--a {
    width: min(38vw, 280px);
    height: min(22vw, 150px);
    transform: rotateX(66deg) rotateZ(-8deg);
    animation: ambient-spin 18s linear infinite;
  }

  .ambient-ring--b {
    width: min(48vw, 360px);
    height: min(28vw, 190px);
    border-color: rgba(96, 165, 250, 0.12);
    transform: rotateX(66deg) rotateZ(12deg);
    animation: ambient-spin 26s linear infinite reverse;
  }

  .ambient-core {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff, #93c5fd 45%, #2563eb 100%);
    box-shadow: 0 0 24px rgba(96, 165, 250, 0.55);
  }

  @keyframes ambient-breathe {
    0%,
    100% {
      transform: scale(0.92);
      opacity: 0.7;
    }
    50% {
      transform: scale(1.05);
      opacity: 1;
    }
  }

  @keyframes ambient-spin {
    to {
      transform: rotateX(66deg) rotateZ(352deg);
    }
  }

  .stage-spline-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: transparent;
    opacity: 0;
    transition: opacity 0.9s ease;
    pointer-events: none;
  }

  .stage.is-spline-ready .stage-spline-frame {
    opacity: 1;
  }

  .stage.is-spline-ready .stage-ambient {
    opacity: 0;
  }

  .stage[data-state="revealed"] .stage-spline {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Overlay only — never adds a second 100svh to the document */
  .stage-splash {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .stage-brand {
    position: absolute;
    top: 1.35rem;
    left: 1.5rem;
    z-index: 2;
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--primary);
    pointer-events: none;
  }

  .click-me {
    pointer-events: auto;
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #f4f7fb;
    cursor: pointer;
    appearance: none;
    font: inherit;
  }

  .click-me-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: min(8vh, 72px);
    padding: 0.7rem 1.15rem;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.28);
    background: rgba(12, 16, 24, 0.72);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    backdrop-filter: blur(12px);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
    color: #f4f7fb;
  }

  .click-me-arrow {
    opacity: 0.8;
    animation: pulse-glow 1.8s ease-in-out infinite;
  }

  .stage.is-spline-ready .click-me-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    box-shadow: none;
    background: transparent;
  }

  .click-me:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: -6px;
  }

  .stage[data-state="revealed"] .stage-splash {
    display: none;
  }

  .stage-reveal {
    position: relative;
    z-index: 3;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 5.5rem 1.5rem 3rem;
    background: var(--background);
  }

  .stage[data-state="splash"] .stage-reveal {
    display: none;
  }

  .reveal-panel {
    width: min(42rem, 100%);
    margin-inline: auto;
    text-align: center;
  }

  .reveal-eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--primary);
  }

  .reveal-title {
    margin: 1rem 0 0;
    font-size: clamp(2.1rem, 4.5vw, 3.35rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .reveal-body {
    margin: 1.15rem auto 0;
    max-width: 34rem;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--muted-foreground);
  }

  .reveal-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
    justify-content: center;
  }

  .reveal-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    justify-content: center;
  }

  .reveal-tags li {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted-foreground);
    background: rgba(255, 255, 255, 0.03);
  }

  .reveal-note {
    margin: 1.1rem 0 0;
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  @media (max-width: 640px) {
    .stage-spline-frame {
      display: none;
    }

    .stage-ambient {
      opacity: 1;
    }

    .stage.is-spline-ready .click-me-label {
      position: static;
      width: auto;
      height: auto;
      margin-top: min(10vh, 88px);
      padding: 0.7rem 1.15rem;
      overflow: visible;
      clip: auto;
      white-space: normal;
      border: 1px solid rgba(148, 163, 184, 0.28);
      background: rgba(12, 16, 24, 0.72);
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
    }

    .click-me:focus-visible {
      outline-offset: 3px;
    }
  }
</style>
