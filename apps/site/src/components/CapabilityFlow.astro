---
const steps = [
  {
    id: "discover",
    title: "Discover",
    body: "Find capability providers on-chain via The Graph and ENS.",
  },
  {
    id: "verify",
    title: "Verify",
    body: "Confirm identity with ENSv2 / ERC-8004 before any payment.",
  },
  {
    id: "pay",
    title: "Pay",
    body: "Settle with Hedera x402 and Blocky402 — real testnet payment.",
  },
  {
    id: "execute",
    title: "Execute",
    body: "Call the provider over A2A and return structured results.",
  },
] as const;
---

<section
  id="flow"
  aria-labelledby="flow-heading"
  class="relative mx-auto max-w-6xl px-6 pb-28 pt-10"
  data-testid="capability-flow"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-px"
    style="background: linear-gradient(90deg, transparent, rgba(96,165,250,0.45), transparent);"
  >
  </div>

  <div class="mb-12 max-w-2xl">
    <p class="text-sm font-semibold tracking-[0.18em] text-[var(--primary)] uppercase">P0 path</p>
    <h2
      id="flow-heading"
      class="mt-3 text-3xl font-bold tracking-tight text-[var(--foreground)] sm:text-4xl"
    >
      Discover → Verify → Pay → Execute
    </h2>
    <p class="mt-3 text-[var(--muted-foreground)]">
      The hackathon demo is driven by CLI / A2A — this page explains the path. No invented success
      states on the showcase surface.
    </p>
  </div>

  <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      steps.map((step, index) => (
        <li
          data-testid={`flow-step-${step.id}`}
          class="group relative overflow-hidden rounded-2xl border border-[var(--border)] bg-white/[0.03] p-5 backdrop-blur-md transition duration-300 hover:border-sky-400/35 hover:bg-white/[0.05]"
        >
          <div
            aria-hidden="true"
            class="pointer-events-none absolute -right-8 -top-8 h-24 w-24 rounded-full opacity-0 blur-2xl transition group-hover:opacity-100"
            style="background: rgba(59,130,246,0.35);"
          />
          <span class="text-xs font-semibold tracking-[0.16em] text-[var(--primary)]">
            {String(index + 1).padStart(2, "0")}
          </span>
          <h3 class="mt-3 text-lg font-semibold text-[var(--foreground)]">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--muted-foreground)]">{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>
