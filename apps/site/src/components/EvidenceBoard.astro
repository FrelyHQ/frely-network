---
import {
  EVIDENCE_STAGES,
  EVIDENCE_TERMINAL,
  STAGE_LABELS,
  TERMINAL_LABELS,
} from "../lib/evidence";
---

<section class="mx-auto max-w-3xl px-6 pb-20 pt-28" data-testid="evidence-board">
  <p class="text-sm font-medium tracking-wide text-[var(--primary)]">Issue #17 · API-010</p>
  <h1 class="mt-2 text-3xl font-semibold tracking-tight text-[var(--foreground)] sm:text-4xl">
    Execution evidence (read-only)
  </h1>
  <p class="mt-3 text-[var(--muted-foreground)]">
    This console only displays a desensitized projection for one <code class="text-[var(--foreground)]">executionId</code>.
    It does not run Discover → Pay → Execute, hold keys, or call Graph / ENS / Hedera / Providers from the browser.
  </p>

  <div
    class="mt-6 rounded-xl border border-[var(--border)] bg-[var(--muted)] p-4 text-sm text-[var(--foreground)]"
    data-testid="evidence-gate"
    role="status"
  >
    <p class="font-semibold">Live projection: not available</p>
    <p class="mt-2 text-[var(--muted-foreground)]">
      Per <code class="text-[var(--foreground)]">interface-contracts.md</code>, API-010 is still
      <strong>Planned</strong>: HTTP path and fields are not frozen. Broker has not published a
      read-only evidence endpoint on the shared remote tip. Stages below stay
      <strong>not_provided</strong> — this page does not invent success, fixtures, or transaction
      references.
    </p>
    <p class="mt-2 text-[var(--muted-foreground)]">
      When B provides an authenticated projection, this UI will bind the same
      <code class="text-[var(--foreground)]">executionId</code> without changing P0 ownership.
    </p>
  </div>

  <div class="mt-10">
    <h2 class="text-lg font-semibold text-[var(--foreground)]">Ordered stages (API-010)</h2>
    <ol class="mt-4 space-y-3" data-testid="evidence-stage-list">
      {
        EVIDENCE_STAGES.map((stage, index) => (
          <li
            class="rounded-xl border border-[var(--border)] bg-[color-mix(in_oklch,var(--card)_85%,transparent)] p-4"
            data-testid={`evidence-stage-${stage}`}
            data-status="not_provided"
          >
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <p class="text-sm font-semibold text-[var(--foreground)]">
                <span class="text-[var(--primary)]">{String(index + 1).padStart(2, "0")}</span>
                {" "}
                {STAGE_LABELS[stage]}
                <span class="ml-2 font-mono text-xs font-normal text-[var(--muted-foreground)]">
                  ({stage})
                </span>
              </p>
              <span class="rounded-md border border-[var(--border)] bg-[var(--muted)] px-2 py-0.5 text-xs font-medium text-[var(--muted-foreground)]">
                not_provided
              </span>
            </div>
            <p class="mt-2 text-sm text-[var(--muted-foreground)]">
              No server summary for this stage. Missing evidence is shown as-is; it is not treated as
              completed.
            </p>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="mt-10">
    <h2 class="text-lg font-semibold text-[var(--foreground)]">Terminal statuses (when projection ends early)</h2>
    <ul class="mt-4 flex flex-wrap gap-2" data-testid="evidence-terminal-list">
      {
        EVIDENCE_TERMINAL.map((status) => (
          <li
            class="rounded-md border border-[var(--border)] bg-[var(--muted)] px-3 py-1.5 font-mono text-xs text-[var(--foreground)]"
            data-testid={`evidence-terminal-${status}`}
          >
            {TERMINAL_LABELS[status]}
          </li>
        ))
      }
    </ul>
    <p class="mt-3 text-sm text-[var(--muted-foreground)]">
      Pending / blocked / failed / payment_unknown / completed must come from the server projection.
      This shell only reserves labels from the contract.
    </p>
  </div>
</section>
