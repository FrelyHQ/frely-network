---
const GITHUB = "https://github.com/FrelyHQ/frely-network";
---

<header class="absolute inset-x-0 top-0 z-20">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="#top" class="flex items-center gap-2.5" aria-label="Frely Network home">
      <img src="/logo.jpg" alt="" width="132" height="36" class="h-8 w-auto object-contain" />
    </a>
    <nav class="flex items-center gap-6 text-sm text-[var(--muted-foreground)]">
      <a href="#flow" class="transition-colors hover:text-[var(--foreground)]">How it works</a>
      <a
        href={GITHUB}
        target="_blank"
        rel="noreferrer"
        class="btn btn-primary btn-sm"
        data-testid="nav-github"
      >
        GitHub
      </a>
    </nav>
  </div>
</header>
