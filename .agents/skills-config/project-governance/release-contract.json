{
  "schema": "project-governance.release-contract.v1",
  "project": "frely-network",
  "release_type": "deploy",
  "entrypoint": "./scripts/release",
  "integration_branch": "main",
  "version": {
    "scheme": "semver",
    "default": "next-patch-from-latest-formal-release",
    "explicit": true
  },
  "source": {
    "clean_worktree": true,
    "branch_main": true,
    "local_contains_origin_main": true,
    "full_release_sha": true,
    "allow_non_force_main_push": true
  },
  "tag_profile": {
    "kind": "target",
    "template": "release/frely-network/v{version}"
  },
  "stages": [
    "preflight",
    "verify",
    "build",
    "deploy",
    "runtime verification",
    "tag / release metadata"
  ],
  "target": {
    "name": "frely-network",
    "environment": "production"
  },
  "artifact": "ghcr.io/frelyhq/frely-network image",
  "destination": "ctb-eu / frely-network",
  "verification": [
    "https://network.frely.cloud/readyz",
    "frely-network container health"
  ]
}
