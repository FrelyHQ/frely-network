{
  "name": "frely-network",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/protocol/*",
    "packages/discovery/*",
    "packages/identity/*",
    "packages/payment/*",
    "packages/broker",
    "packages/gateway/*",
    "apps/*",
    "examples/*",
    "scripts/*"
  ],
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
