{
  "name": "frely-network",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/protocol/*",
    "packages/discovery/*",
    "packages/identity/*",
    "packages/payment/*",
    "packages/wallet/*",
    "packages/broker",
    "packages/gateway/*",
    "apps/*",
    "examples/*",
    "scripts/*"
  ],
  "scripts": {
    "agent": "bun apps/agent-cli/index.ts",
    "payment:check": "bun scripts/payment-spike/index.ts",
    "typecheck": "tsc --project tsconfig.json",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "acceptance:static-preflight": "bun scripts/static-provider-e2e/preflight.ts",
    "acceptance:static-live": "bun scripts/static-provider-e2e/live.ts"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "typescript": "6.0.3"
  }
}
