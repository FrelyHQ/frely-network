{
  "name": "frely-network",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/protocol/*",
    "packages/discovery/*",
    "packages/identity/*",
    "packages/payment/*",
    "packages/broker",
    "packages/gateway/*",
    "apps/broker-mcp",
    "apps/explorer",
    "examples/*",
    "scripts/*"
  ],
  "scripts": {
    "build": "bun build apps/broker-mcp/server.ts --target=bun --outfile=dist/broker-mcp.js",
    "start": "bun dist/broker-mcp.js",
    "typecheck": "tsc --project tsconfig.json",
    "test": "bun test",
    "verify:compose": "docker compose --env-file .env.example -f compose.production.yaml config --quiet",
    "check": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "typescript": "6.0.3"
  }
}
