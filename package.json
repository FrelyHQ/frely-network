{
  "name": "frely-network",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/protocol/*",
    "packages/discovery/*",
    "packages/identity/*",
    "packages/payment/*",
    "packages/broker",
    "packages/gateway/*",
    "apps/*",
    "examples/*",
    "scripts/*"
  ],
  "scripts": {
    "ens:subnames": "bun scripts/register-provider/ens-subnames.ts",
    "explorer:build": "bun build apps/explorer/src/main.ts --outdir apps/explorer/dist --target browser --minify",
    "explorer:dev": "bun run explorer:build && bun apps/explorer/server.ts",
    "typecheck": "tsc --project tsconfig.json",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "typescript": "6.0.3"
  }
}
